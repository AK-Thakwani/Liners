{
  "name": "liners-fullstack",
  "version": "1.0.0",
  "description": "MERN Stack Social Media Platform - Liners",
  "main": "backend/index.js",
  "scripts": {
    "install-all": "npm install && cd frontend && npm install && cd ../backend && npm install",
    "start:frontend": "cd frontend && npm start",
    "start:backend": "cd backend && npm run dev",
    "start": "concurrently --kill-others-on-fail \"npm run start:frontend\" \"npm run start:backend\"",
    "dev": "concurrently \"npm run start:frontend\" \"npm run start:backend\"",
    "build:frontend": "cd frontend && npm run build",
    "build:backend": "echo 'Backend ready for deployment'",
    "build": "npm run build:frontend && npm run build:backend",
    "test": "echo 'Run tests'"
  },
  "keywords": [
    "MERN",
    "Social Media",
    "React",
    "Express",
    "MongoDB",
    "Node.js"
  ],
  "author": "Your Name",
  "license": "MIT",
  "devDependencies": {
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.2.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.11"
  },
  "dependencies": {
    "@react-oauth/google": "^0.12.2",
    "@splinetool/react-spline": "^4.1.0",
    "bootstrap": "^5.3.7",
    "framer-motion": "^12.33.0",
    "lenis": "^1.3.17",
    "react-bootstrap": "^2.10.10",
    "react-icons": "^5.5.0",
    "react-intersection-observer": "^10.0.2"
  }
}
